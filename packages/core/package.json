{
  "name": "@dominate-color.js/core",
  "version": "1.1.1",
  "description": "A library that can extract the primary color and its hue in RGBA format and convert it.",
  "keywords": [
    "TypeScript",
    "color algorithms",
    "color analysis",
    "color detection",
    "color palette",
    "color spaces",
    "colors",
    "computer vision",
    "dominant color",
    "image processing"
  ],
  "homepage": "https://github.com/Dominate-color/dominate-color-js#readme",
  "bugs": {
    "url": "https://github.com/Dominate-color/dominate-color-js/issues"
  },
  "license": "MIT",
  "author": "TrySquad DF <https://t.me/TrySquadDF>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dominate-color/dominate-color-js.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/dts/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/dts/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "vitest run --config ../../vitest.config.ts --project core",
    "lint": "oxlint --config ../../.oxlintrc.json src tests --deny-warnings",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.declarations.json"
  },
  "devDependencies": {
    "oxlint": "catalog:quality",
    "tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:testing"
  }
}
